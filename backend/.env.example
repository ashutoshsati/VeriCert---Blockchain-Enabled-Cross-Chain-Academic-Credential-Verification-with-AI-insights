# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (local install or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/vericert

# Port the API listens on
PORT=3000

# Secret required in the x-api-key header for /issue and /revoke.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Optional: where the mock chain saves its state (defaults to backend/mock-chain.json)
# MOCK_CHAIN_FILE=
