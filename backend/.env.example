# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (local install or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/vericert

# Port the API listens on
PORT=3000

# Secret required in the x-api-key header for /issue and /revoke.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Which blockchain to use:
#   mock - local JSON file, instant, no wallet needed (default)
#   ccip - real contracts: VeriCert on Polygon Amoy relaying to Receiver on Avalanche Fuji
# Use a separate MONGODB_URI database name per mode (e.g. vericert-ccip for ccip): records created
# under one mode are not visible in the other, so switching modes against the same database leaves
# stale records that 404 or stay pending forever.
CHAIN_MODE=mock

# Optional: where the mock chain saves its state (defaults to backend/mock-chain.json)
# MOCK_CHAIN_FILE=

# ---- Required only when CHAIN_MODE=ccip (see contracts/DEPLOYMENT.md) ----

# Network endpoints (public ones below, or a personal Alchemy/Infura URL)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# MetaMask -> Account details -> Show private key.
# Use a wallet that only ever holds testnet tokens. This wallet must be an approved issuer on VeriCert.
ISSUER_PRIVATE_KEY=

# Printed when the contracts are deployed
VERICERT_ADDRESS=
RECEIVER_ADDRESS=

# ---- Optional: AI explanations (POST /explain) ----
# Without a key the server still runs; /explain then returns the checks and says the AI summary isn't set up.
OPENAI_API_KEY=
# Cheapest suitable model; change only if the team agrees
OPENAI_MODEL=gpt-6-luna
# New AI summaries allowed per day across the whole server (saved summaries don't count)
AI_DAILY_LIMIT=500
